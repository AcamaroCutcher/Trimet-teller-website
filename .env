# TriMet API Configuration
# Edit this file and add your TriMet API key below
# Get your free API key at: https://developer.trimet.org/

# Replace YOUR_API_KEY_HERE with your actual TriMet API key
TRIMET_API_KEY=YOUR_API_KEY_HERE

# Stop ID is hard-coded to Providence Park Station Eastbound
STOP_ID=9758

# Optional: Add OpenWeatherMap API key for detailed weather
# Leave as-is to use free weather API
WEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY_HERE
